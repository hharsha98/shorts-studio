  "en": {
    "lines": [
      {
        "scene": "hook",
        "text": "When a machine or interface stops, every minute of searching costs output."
      },
      {
        "scene": "evidence",
        "text": "Your postings ask for people who find the root cause when something sticks.",
        "cues": {
          "evidence.0": "ask",
          "evidence.1": "root",
          "evidence.2": "sticks"
        }
      },
      {
        "scene": "pain",
        "text": "The answers sit in manuals, logs, old tickets, and a few experienced heads.",
        "cues": {
          "pain.0": "manuals",
          "pain.1": "logs",
          "pain.2": "tickets",
          "pain.3": "experienced"
        }
      },
      {
        "scene": "idea",
        "text": "One idea: a root cause assistant."
      },
      {
        "scene": "arch",
        "text": "It reads the error and the logs, and searches manuals and past fixes.",
        "cues": {
          "arch.inputs": "reads",
          "arch.search": "searches"
        }
      },
      {
        "scene": "arch",
        "text": "AI agents rank likely causes, each with evidence and a next check.",
        "cues": {
          "arch.agents": "agents"
        }
      },
      {
        "scene": "arch",
        "text": "A technician confirms, and the fix becomes knowledge for the next shift.",
        "cues": {
          "arch.human": "technician",
          "arch.learn": "knowledge",
          "arch.badges": "shift"
        }
      },
      {
        "scene": "proof",
        "text": "Real result at Siemens Amberg: on 16 machines, root cause analysis went from 30 to 120 minutes per fault, down to 8 to 15.",
        "cues": {
          "proof": "Real"
        }
      },
      {
        "scene": "metrics",
        "text": "Here, the numbers stay illustrative until a pilot measures them.",
        "cues": {
          "metrics.0": "numbers",
          "metrics.1": "until"
        }
      },
      {
        "scene": "pilot",
        "text": "A pilot could start with one line and its top faults.",
        "cues": {
          "pilot.0": "pilot",
          "pilot.1": "line",
          "pilot.2": "faults"
        }
      },
      {
        "scene": "closing",
        "text": "Happy to explore it with you."
      }
    ],
