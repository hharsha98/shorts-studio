    "lines": [
      {
        "scene": "hook",
        "text": "Viele Ihrer offenen Stellen verlangen jahrelange, sehr spezielle Erfahrung."
      },
      {
        "scene": "evidence",
        "text": "Küchenbestellungen, Katalogdaten, Kantenanleimmaschinen.",
        "cues": {
          "evidence.0": "Küchenbestellungen",
          "evidence.1": "Katalogdaten",
          "evidence.2": "Kantenanleimmaschinen"
        }
      },
      {
        "scene": "pain",
        "text": "Dieses Wissen ist schwer zu finden, braucht lange Einarbeitung und liegt bei wenigen Fachleuten.",
        "cues": {
          "pain.0": "schwer",
          "pain.1": "Einarbeitung",
          "pain.2": "wenigen"
        }
      },
      {
        "scene": "idea",
        "text": "Eine Idee: ein Assistent, der aus Ihren eigenen Dokumenten antwortet."
      },
      {
        "scene": "arch",
        "text": "Man fragt in einfachen Worten, er durchsucht Anweisungen, Regeln, Handbücher und gelöste Fälle.",
        "cues": {
          "arch.ask": "fragt",
          "arch.docs": "durchsucht"
        }
      },
      {
        "scene": "arch",
        "text": "Jede Antwort nennt ihre Quelle. Steht es nicht drin, sagt er das und nennt eine Fachperson.",
        "cues": {
          "arch.answer": "Antwort",
          "arch.expert": "Steht"
        }
      },
      {
        "scene": "arch",
        "text": "Er läuft auf Ihren Servern, achtet auf Zugriffsrechte und bewertet niemals Menschen.",
        "cues": {
          "arch.badges": "läuft"
        }
      },
      {
        "scene": "proof",
        "text": "In veröffentlichter Forschung an der Uni Erlangen erreichte ein lokales System dieser Art eine Quellentreue von 0,97.",
        "cues": {
          "proof": "veröffentlichter",
          "proof.fact.3": "lokales",
          "proof.fact.0": "Quellentreue"
        }
      },
      {
        "scene": "metrics",
        "text": "Beispielhafte Ziele: weniger Unterbrechungen für Fachleute, schnellere Einarbeitung.",
        "cues": {
          "metrics.0": "weniger",
          "metrics.1": "schnellere"
        }
      },
      {
        "scene": "pilot",
        "text": "Ein Pilot könnte mit einem Team starten, etwa in der Auftragsbearbeitung.",
        "cues": {
          "pilot.0": "Pilot",
          "pilot.1": "Team",
          "pilot.2": "Auftragsbearbeitung"
        }
      },
      {
        "scene": "closing",
        "text": "Mehr dazu gern im Gespräch."
      }
    ],
