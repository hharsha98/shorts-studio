  "en": {
    "lines": [
      {
        "scene": "hook",
        "text": "Many of your open roles ask for years of very specific experience."
      },
      {
        "scene": "evidence",
        "text": "Kitchen orders, catalogue data, edge banding machines.",
        "cues": {
          "evidence.0": "Kitchen",
          "evidence.1": "catalogue",
          "evidence.2": "edge"
        }
      },
      {
        "scene": "pain",
        "text": "That know-how is hard to hire, slow to teach, and sits with a few experts.",
        "cues": {
          "pain.0": "hard",
          "pain.1": "slow",
          "pain.2": "few"
        }
      },
      {
        "scene": "idea",
        "text": "One idea: an assistant that answers questions from your own documents."
      },
      {
        "scene": "arch",
        "text": "A colleague asks in plain words. It searches instructions, rules, manuals and solved cases.",
        "cues": {
          "arch.ask": "colleague",
          "arch.docs": "searches"
        }
      },
      {
        "scene": "arch",
        "text": "Each answer shows its source. If the documents don't cover it, it says so and names an expert.",
        "cues": {
          "arch.answer": "answer",
          "arch.expert": "cover"
        }
      },
      {
        "scene": "arch",
        "text": "It runs on your servers, respects access rights, and never rates people.",
        "cues": {
          "arch.badges": "runs"
        }
      },
      {
        "scene": "proof",
        "text": "In published research at FAU, a local system like this reached 0.97 faithfulness to its sources.",
        "cues": {
          "proof": "published",
          "proof.fact.3": "local",
          "proof.fact.0": "0.97"
        }
      },
      {
        "scene": "metrics",
        "text": "Illustrative targets: fewer interruptions for experts, and faster onboarding.",
        "cues": {
          "metrics.0": "fewer",
          "metrics.1": "faster"
        }
      },
      {
        "scene": "pilot",
        "text": "A pilot could start with one team, such as order handling.",
        "cues": {
          "pilot.0": "pilot",
          "pilot.1": "team",
          "pilot.2": "order"
        }
      },
      {
        "scene": "closing",
        "text": "Happy to explore it with you."
      }
    ],
