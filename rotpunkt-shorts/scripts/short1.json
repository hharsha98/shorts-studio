      {
        "scene": "idea",
        "text": "Eine Idee: ein KI-Assistent für die Auftragsprüfung."
      },
      {
        "scene": "arch",
        "text": "Er liest jede Bestellung, per EDI, als PDF oder E-Mail, in jeder Sprache.",
        "say": "Er liest jede Bestellung, per E-D-I, als PDF oder E-Mail, in jeder Sprache.",
        "cues": {
          "arch.inputs": "liest"
        }
      },
      {
        "scene": "arch",
