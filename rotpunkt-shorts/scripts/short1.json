  "en": {
    "lines": [
      {
        "scene": "hook",
        "text": "Order errors are cheap at the desk, and expensive in production."
      },
      {
        "scene": "evidence",
        "text": "Your postings show who catches them today: experienced staff checking every dealer order, often for export.",
        "cues": {
          "evidence.0": "experienced",
          "evidence.1": "checking",
          "evidence.2": "export"
        }
      },
      {
        "scene": "pain",
        "text": "Variants, dimensions, dependencies: one missed detail means rework.",
        "cues": {
          "pain.chips": "Variants",
          "pain.0": "missed",
          "pain.1": "detail",
          "pain.2": "rework"
        }
      },
      {
        "scene": "idea",
        "text": "One idea: an order check assistant."
      },
      {
        "scene": "arch",
        "text": "It reads each order, from EDI, PDF or email, in any language.",
        "cues": {
          "arch.inputs": "reads"
        }
      },
      {
        "scene": "arch",
        "text": "An AI agent extracts the lines and checks them against your product rules.",
        "cues": {
          "arch.agent": "agent",
          "arch.rules": "rules"
        }
      },
      {
        "scene": "arch",
        "text": "Conflicts come with their source, and a clerk decides.",
        "cues": {
          "arch.checks": "Conflicts"
        }
      },
      {
        "scene": "arch",
        "text": "Only approved orders reach the ERP, with local models and GDPR in mind.",
        "cues": {
          "arch.erp": "approved",
          "arch.badges": "local"
        }
      },
      {
        "scene": "metrics",
        "text": "Illustrative pilot targets: checking time from twenty minutes to five, and far fewer errors found in production.",
        "cues": {
          "metrics.0": "checking",
          "metrics.1": "fewer"
        }
      },
      {
        "scene": "proof",
        "text": "The same building blocks already run in production at Siemens Amberg.",
        "cues": {
          "proof": "same"
        }
      },
      {
        "scene": "pilot",
        "text": "A pilot could start with one product line.",
        "cues": {
          "pilot.0": "pilot",
          "pilot.1": "start",
          "pilot.2": "product"
        }
      },
      {
        "scene": "closing",
        "text": "Happy to explore it with you."
      }
    ],
