        "text": "Ein Pilot könnte mit einer Produktlinie starten.",
        "cues": {
          "pilot.0": "Pilot",
          "pilot.1": "könnte",
          "pilot.2": "Produktlinie"
        }
      },
      {
        "scene": "closing",
        "text": "Mehr dazu gern im Gespräch."
      }
    ],
